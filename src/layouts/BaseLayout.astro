---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NOME, SITE_DESCRICAO, url } from '../lib/site';

interface Props {
  titulo?: string;
  descricao?: string;
  /** true = pede aos buscadores para nao indexar a pagina (ferramentas internas). */
  noindex?: boolean;
}

const { titulo, descricao = SITE_DESCRICAO, noindex = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${SITE_NOME}` : SITE_NOME;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NOME} href={url('/rss.xml')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:locale" content="pt_BR" />
    <!-- Aplica o tema antes de pintar a pagina, para nao piscar. -->
    <script is:inline>
      try {
        var t = localStorage.getItem('tema');
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .pular {
    position: absolute;
    left: -9999px;
    top: 0.5rem;
    z-index: 100;
    background: var(--destaque);
    color: var(--sobre-destaque);
    padding: 0.5rem 1rem;
    border-radius: 6px;
  }
  .pular:focus { left: 0.5rem; }
</style>
