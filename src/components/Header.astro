---
import { NAV, SITE_NOME, url } from '../lib/site';

const atual = Astro.url.pathname;
const ativo = (href: string) => atual.startsWith(url(href));
---

<header class="cab">
  <div class="container cab-int">
    <a class="marca" href={url('/')}>{SITE_NOME}</a>
    <nav class="nav" aria-label="Principal">
      {NAV.map((n) => (
        <a href={url(n.href)} aria-current={ativo(n.href) ? 'page' : undefined}>{n.rotulo}</a>
      ))}
      <button type="button" class="tema" id="alterna-tema" aria-label="Alternar tema claro e escuro">◐</button>
    </nav>
  </div>
</header>

<script>
  document.getElementById('alterna-tema')?.addEventListener('click', () => {
    const raiz = document.documentElement;
    const novo = raiz.dataset.theme === 'dark' ? 'light' : 'dark';
    raiz.dataset.theme = novo;
    try {
      localStorage.setItem('tema', novo);
    } catch {}
  });
</script>

<style>
  .cab-int { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-block: 1.6rem 1.2rem; }
  .marca { font-family: var(--f-titulo); font-weight: 600; font-size: 1.05rem; text-decoration: none; }
  .nav { display: flex; align-items: baseline; gap: 1.2rem; font-family: var(--f-mono); font-size: 0.85rem; }
  .nav a { text-decoration: none; color: var(--texto-suave); }
  .nav a:hover { color: var(--hover); }
  .nav a[aria-current='page'] { color: var(--texto); text-decoration: underline; text-underline-offset: 5px; }
  .tema { border: 0; background: none; cursor: pointer; font-size: 1rem; padding: 0; color: var(--texto-suave); line-height: 1; }
  .tema:hover { color: var(--hover); }
</style>
